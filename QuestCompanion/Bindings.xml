<!-- Raccourcis de QuestCompanion (menu Raccourcis du jeu, section « QuestCompanion ») :
     noms et en-tête dans Bindings.lua (BINDING_HEADER_ / BINDING_NAME_), fonctions globales aussi. -->
<Bindings>
	<Binding name="QUESTCOMPANION_FEATS" header="QUESTCOMPANION" category="ADDONS">
		QuestCompanion_ToggleFeats()
	</Binding>
	<Binding name="QUESTCOMPANION_JOURNAL" category="ADDONS">
		QuestCompanion_ToggleJournal()
	</Binding>
	<Binding name="QUESTCOMPANION_TOGGLE" category="ADDONS">
		QuestCompanion_ToggleCompanion()
	</Binding>
	<Binding name="QUESTCOMPANION_NET" category="ADDONS">
		QuestCompanion_ThrowNet()
	</Binding>
	<Binding name="QUESTCOMPANION_HUNT" category="ADDONS">
		QuestCompanion_ToggleHunt()
	</Binding>
</Bindings>
