# Paquet Ready2Quest (CurseForge, Wago) : BigWigsMods/packager, voir docs/PUBLIER.md.
# Le paquet livre uniquement l'addon : code Lua, médias, licence.
# Le dépôt contient aussi QuestCompanion (sous-dossier), publié à part avec
# .pkgmeta-questcompanion : il est exclu d'ici, comme le développement
# (tests/, tools/, docs/) et les fichiers de dépôt.
# Garde-fou : tests/run_tests.py vérifie ces listes à chaque lancement.
package-as: Ready2Quest

ignore:
  - .git
  - .gitattributes
  - .gitignore
  - .pkgmeta
  - .pkgmeta-questcompanion
  - .github
  - QuestCompanion
  - tests
  - tools
  - docs
  - README.md
  - "*.py"
  - "*.bak"
  - "*.orig"
  - "*.log"
  - "*~"
  - "__pycache__"
  - "_*.py"
  - "_block.lua"

enable-nolib-creation: no

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

license-output: LICENSE
